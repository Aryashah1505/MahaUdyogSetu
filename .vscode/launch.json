{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run & Debug MahaUdyogSetu (Dev Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "cwd": "${workspaceFolder}",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch Frontend in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "name": "Run Production Server (dist/server.cjs)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/server.cjs",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000"
      },
      "console": "integratedTerminal"
    }
  ]
}
